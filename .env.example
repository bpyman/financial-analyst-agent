# Copy to .env and fill in. Never commit .env.

# SEC EDGAR — required for live quarterly facts
# Format: "AppName (contact@example.com)"
SEC_USER_AGENT=FinancialAnalystAgent (you@example.com)
SEC_BASE_URL=https://data.sec.gov
SEC_MAX_REQUESTS_PER_SECOND=5
SEC_TIMEOUT_SECONDS=30
SEC_CACHE_DIR=.cache/sec

# Financial Modeling Prep — snapshot build + batch market caps
# Use the current /stable endpoints, not discontinued /api/v3.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# OpenAI — structured intent planner and explain essays
# Pin a Structured Outputs–capable model (v1 used gpt-4o-2024-11-20)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tavily — search_news backend (topic=news). Free-tier key is enough.
TAVILY_API_KEY=

# live = SEC/OpenAI/Tavily (local). fixture = recorded adapters (public demo default).
APP_MODE=fixture
PUBLIC_DEMO=false
DEMO_LIVE_SEC=false
ALLOW_PUBLIC_OPENAI=false
ALLOW_PUBLIC_TAVILY=false
THREAD_TTL_SECONDS=7200
MAX_TURNS_PER_THREAD=25
MAX_LIVE_SEC_REQUESTS_PER_THREAD=25
SNAPSHOT_STALE_AFTER_DAYS=30
