# Streamlit Community Cloud / hosted demo

# Default the public app to the recorded runtime. Visitors do not supply keys.
APP_MODE = "recorded"
PUBLIC_DEMO = "true"
DEMO_LIVE_SEC = "false"
ALLOW_PUBLIC_OPENAI = "false"
ALLOW_PUBLIC_TAVILY = "false"
THREAD_TTL_SECONDS = 7200
MAX_TURNS_PER_THREAD = 25
MAX_LIVE_SEC_REQUESTS_PER_THREAD = 25
SEC_CACHE_DIR = ".cache/sec"
SEC_USER_AGENT = "FinancialAnalystAgent (you@example.com)"
