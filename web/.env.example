# Copy to .env.local for `npm run dev` / `npm start`. Server-side only: neither
# variable is NEXT_PUBLIC_, so neither reaches the browser bundle.

# Where the proxy route (app/api/[...path]/route.ts) sends /api/* calls.
API_ORIGIN=http://127.0.0.1:8000

# Shared secret the proxy sends to the API as X-Proxy-Token. Must equal the API's
# API_PROXY_TOKEN. Leave blank locally when the API has none.
API_PROXY_TOKEN=
